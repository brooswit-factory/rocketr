# rocketr is stateless: there is no account registry, token, or secret to put in this file any
# more. Every client connection carries its own Rocket.Chat URL and credentials in headers — see
# README.md "Connection headers". These are the only process-level settings left, set in the
# environment (the systemd unit), not a config file.

# Listen address. Defaults to loopback-only; refuses anything but loopback, the tailnet range
# (100.64.0.0/10), or a ULA address — no opt-in for a public bind. In the standard deployment,
# Caddy terminates TLS and is the only public listener, reverse-proxying to rocketr over loopback.
ROCKETR_HOST=127.0.0.1
ROCKETR_PORT=8790

# Optional — download_attachment's "local" mode (an explicit opt-in; "remote", returning bytes in
# the tool result, is the default and needs none of this).
# ROCKETR_ATTACHMENT_DIR=~/.local/share/rocketr/attachments
# ROCKETR_ATTACHMENT_MAX_BYTES=26214400
# ROCKETR_ATTACHMENT_TYPES=image/png,image/jpeg,image/gif,image/webp,audio/*,application/pdf,text/plain
