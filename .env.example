# rocketr reads these from the environment or from ~/.config/rocketchat/secrets.env
# (override the file path with ROCKETR_ENV_FILE). Process env wins.
ROCKETR_URL=https://chat.example.com
# Every account rocketr signs in as; connections must pick one (x-rocketr-account). No default.
ROCKETR_ACCOUNTS=claude,rocketr-lead
ROCKETR_ACCOUNT_CLAUDE_USER_ID=
ROCKETR_ACCOUNT_CLAUDE_TOKEN=
ROCKETR_ACCOUNT_ROCKETR_LEAD_USER_ID=
ROCKETR_ACCOUNT_ROCKETR_LEAD_TOKEN=
# Per-account client secret for MCP connections (>=32 chars; generate with `openssl rand -base64 32`).
# Distinct from _TOKEN above. An account with none set is unauthenticated while loopback-bound AND
# ROCKETR_ALLOW_UNAUTHENTICATED_LOOPBACK=true; otherwise it is refused. See README "Client authentication".
# ROCKETR_ACCOUNT_CLAUDE_CLIENT_SECRET=
# ROCKETR_ACCOUNT_ROCKETR_LEAD_CLIENT_SECRET=
# Transition only; secure-by-default end state is false (unset).
# ROCKETR_ALLOW_UNAUTHENTICATED_LOOPBACK=true
# Optional
# Level saved on each account's rooms that have no notification preference yet: all | mentions | nothing.
ROCKETR_DEFAULT_NOTIFICATIONS=mentions
# One recovery startup only: convert existing broad room settings to mentions, then remove this setting.
# ROCKETR_MIGRATE_LEGACY_ALL_TO_MENTIONS=true
# Messages in one room/thread within this many ms become one turn (0 = off).
ROCKETR_BATCH_MS=2000
ROCKETR_POLL_MS=3000
ROCKETR_HOST=127.0.0.1
ROCKETR_PORT=8790
