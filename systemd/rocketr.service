[Unit]
Description=rocketr — Rocket.Chat bridge for Claude Code (thatch MCP server + channel + observer web app)
# Needs the network to reach Rocket.Chat; the watcher backs off and retries while it is down.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# bun is often outside the user manager's default PATH (e.g. ~/.bun/bin).
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Credentials are read from ~/.config/rocketchat/secrets.env (override with ROCKETR_ENV_FILE).
# ExecStart is a TEMPLATE: scripts/install.sh substitutes both placeholders with this
# machine's resolved bun and clone paths, escaped for systemd's quoting rules.
ExecStart="@@BUN_PATH@@" run "@@REPO_ROOT@@/src/index.ts"
Restart=on-failure
# A misconfigured account (or all of them) failing preflight is a config problem a human has to fix,
# not a transient blip — hammering it every 5s is pure noise. Back off progressively instead: 5s, then
# growing over RestartSteps attempts up to RestartMaxDelaySec, so the interval a person sees in
# `journalctl` slows down the longer the daemon has been failing. (Requires systemd >= 254; on an older
# systemd these two keys are ignored with a warning and RestartSec's flat 5s still applies.)
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=60

[Install]
WantedBy=default.target
