# rocketr reads these from the environment or from ~/.config/rocketchat/secrets.env
# (override the file path with ROCKETR_ENV_FILE). Process env wins.
ROCKETR_URL=https://chat.example.com
ROCKETR_USER_ID=
ROCKETR_TOKEN=
# Usernames whose DMs and @mentions are pushed into sessions. Empty = push nothing.
ROCKETR_ALLOW=
# Optional
ROCKETR_POLL_MS=3000
ROCKETR_HOST=127.0.0.1
ROCKETR_PORT=8790
